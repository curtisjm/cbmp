{
  "name": "cbmp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently --names web,convex --prefix-colors blue,magenta --kill-others-on-fail \"pnpm dev:web\" \"pnpm dev:convex\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:convex": "convex dev",
    "dev:backend": "pnpm dev:convex",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit --project convex/tsconfig.json",
    "build": "next build",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:unit": "vitest run",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.54",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
