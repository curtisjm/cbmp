# Clerk identity/session configuration.
# Replace these placeholders locally; do not commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key

# Public Clerk route defaults used by the app shell.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Convex backend configuration for follow-up slices.
NEXT_PUBLIC_CONVEX_URL=https://replace-with-convex-deployment.convex.cloud
CONVEX_DEPLOYMENT=replace-with-convex-deployment-name
