# Clerk identity/session configuration.
# These placeholders are not secrets and intentionally keep Clerk disabled.
# Replace them in .env.local with real Clerk keys when using auth locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_not_a_real_key
CLERK_SECRET_KEY=sk_test_placeholder_not_a_real_secret

# Public Clerk route defaults used by the app shell.
# Issue #3 implements /sign-in only; sign-up UI belongs to a later auth slice.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Convex backend configuration for follow-up slices.
NEXT_PUBLIC_CONVEX_URL=https://replace-with-convex-deployment.convex.cloud
CONVEX_DEPLOYMENT=replace-with-convex-deployment-name
