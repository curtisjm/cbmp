# Optional Clerk identity/session configuration for the current public-data slice.
# These non-secret placeholders are treated as unconfigured. Replace them only in
# .env.local when exercising the existing prebuilt sign-in surface locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_not_a_real_key
CLERK_SECRET_KEY=sk_test_placeholder_not_a_real_secret

# Public Clerk route defaults used by the app shell.
# The current app has no sign-up UI, protected User Profile, or User sync path.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Required for real Convex-backed local development. Leave these blank before
# the first `pnpm dev:convex`; the CLI links a development deployment and writes
# the real values to .env.local. Blank values are treated as unconfigured.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
